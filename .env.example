# ── Supabase ────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Never import into a client component.
# Lives only in lib/supabase/admin.ts, route handlers, and Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Google Places (venue picking — M6) ───────────────────────────────────────
# SERVER key. Powers autocomplete, place details, AND the photo proxy — every
# Places call is proxied server-side so the key never reaches the browser.
# Enable "Places API (New)" on this key in Google Cloud; restrict it to that API.
GOOGLE_MAPS_SERVER_KEY=your-server-maps-key
# (Optional, reserved) A referrer-locked browser key, only if you later embed a
# live Google map. Not used by the current server-proxied flow.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Email (M2 — pick one) ────────────────────────────────────────────────────
# Resend for transactional email; leave blank to use Supabase Auth's provider
RESEND_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
